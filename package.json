{
  "name": "web-node",
  "version": "1.0.643",
  "description": "High level javaScript backend plugin system and configuration merger.",
  "keywords": [
    "api",
    "backend",
    "management",
    "plugin",
    "web"
  ],
  "homepage": "https://tsickert.com/web-node",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/web-node/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/web-node.git"
  },
  "type": "module",
  "bin": "dist/main.js",
  "exports": {
    ".": "./dist/index.js",
    "./main": "./dist/main.js",
    "./main.js": "./dist/main.js",
    "./package.json": "./package.json",
    "./unixCrypt": "./dist/unixCrypt.js",
    "./unixCrypt.js": "./dist/unixCrypt.js",
    "./type": "./dist/type.d.ts"
  },
  "main": "dist/index.js",
  "typesVersions": {
    "*": {
      "type": [
        "./dist/type.d.ts"
      ],
      "unixCrypt": [
        "./dist/unixCrypt.d.ts"
      ]
    }
  },
  "files": [
    "dist/configurator.d.ts",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/main.js",
    "dist/pluginAPI.d.ts",
    "dist/type.d.ts",
    "dist/unixCrypt.d.ts",
    "dist/unixCrypt.js"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "yarn build:types && yarn build:plain",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "prepare:test": "yarn clear && cd src/test/dummyPlugin && shx touch yarn.lock && yarn install && yarn build && cd ../../..",
    "serve": "yarn build:plain && yarn start",
    "start": "./dist/main.js '{core: {plugin: {hotReloading: true}}}'",
    "test": "yarn prepare:test && weboptimizer test",
    "test:coverage": "yarn prepare:test && weboptimizer test:coverage",
    "test:coverage:report": "yarn prepare:test && weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.10",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "clientnode": "^4.0.1532",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.5.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "shx": "^0.4.0",
    "typescript-eslint": "^8.74.0",
    "web-documentation": "^1.0.77",
    "weboptimizer": "^4.0.125"
  },
  "peerDependencies": {
    "clientnode": "*",
    "core-js": "*"
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webNode": {
    "core": {
      "context": {
        "path": "./",
        "type": "relative"
      },
      "debug": false,
      "encoding": "utf8",
      "interDependencies": {},
      "name": "web-node",
      "plugin": {
        "configuration": {
          "fileNames": [
            "package.json",
            "private-package.json"
          ],
          "propertyNames": [
            "webNode",
            "webnode",
            "web-node"
          ]
        },
        "nameRegularExpressionPattern": "^([a-zA-Z0-9-]+?)-?[wW]eb-?[nN]ode-?[pP]lugin$",
        "directories": {
          "external": {
            "path": {
              "__evaluate__": "`${currentPath}/node_modules/`"
            }
          },
          "internal": {
            "nameRegularExpressionPattern": "^([a-zA-Z0-9-_].*)$",
            "path": {
              "__evaluate__": "`${currentPath}/plugins/`"
            }
          }
        },
        "hotReloading": false
      }
    }
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ]
  },
  "webOptimizer": {
    "assetPattern": {
      "javaScript": {
        "includeFilePathRegularExpression": "^(.+/)?main\\.js$",
        "pattern": {
          "#": "This is how we can make our main exported artifact executable.",
          "__evaluate__": "`#!/usr/bin/env node\n// -*- coding: utf-8 -*-\n${self.generic.assetPattern?.javaScript?.pattern ?? ''}\n{1}`"
        }
      }
    },
    "injection": {
      "entry": {
        "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: 'test'} : {index: './index.ts', main: './main.ts', unixCrypt: './unixCrypt.ts'}"
      }
    },
    "module": {
      "optimizer": {
        "javaScript": {
          "minify": {
            "options": {
              "compress": {
                "#": "To provide a logging output we need to exclude this feature.",
                "drop_console": {
                  "__evaluate__": "false"
                },
                "drop_debugger": {
                  "__evaluate__": "false"
                }
              }
            }
          }
        }
      }
    },
    "path": {
      "ignore": {
        "#": "Test fixture plugin which is a yarn project on its own.",
        "__append__": "src/test/dummyPlugin"
      },
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      },
      "tidyUpOnClear": {
        "__append__": {
          "__evaluate__": "path.resolve(self.path.source.base, 'test/dummyPlugin/index.js')"
        }
      }
    },
    "targetTechnology": {
      "boilerplate": "node",
      "payload": "node"
    },
    "webpack": {
      "module": {
        "parser": {
          "javascript": {
            "importMeta": {
              "#": "NOTE: This allows as to access node's native \"import.meta.url\" runtime value for determining the main module.",
              "url": false
            }
          }
        }
      }
    }
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
